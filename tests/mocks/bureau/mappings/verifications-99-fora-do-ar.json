{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/verifications",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.document_number",
          "matches": "^\\d*99$"
        }
      }
    ]
  },
  "response": {
    "status": 503,
    "fixedDelayMilliseconds": 2000
  }
}
